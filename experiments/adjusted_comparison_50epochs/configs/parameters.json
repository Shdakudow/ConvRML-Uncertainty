{
  "protocol": "convrml_pinball_e2e_independent_shuffle_v1",
  "status": "authorized rerun, fresh initialization for all methods",
  "cameras": [
    "rml",
    "diffuser"
  ],
  "train_count": 60000,
  "val_count": 5000,
  "test_count": 5000,
  "calibration_count": 2048,
  "image_shape": [
    3,
